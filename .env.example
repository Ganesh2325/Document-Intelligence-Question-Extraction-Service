# Application
NODE_ENV=development
LOG_LEVEL=info

# API
API_HOST=0.0.0.0
API_PORT=3001
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_API_URL=http://127.0.0.1:3001

# Web
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
WEB_PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://folio:folio@localhost:5432/folio?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6380
WORKER_CONCURRENCY=3

# JWT
# Generate a long random string for any non-local environment.
JWT_SECRET=change-me-in-development-use-a-long-random-value
JWT_EXPIRES_IN=7d

# MinIO / S3-compatible storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=folio-documents
MINIO_USE_SSL=false
MINIO_REGION=us-east-1

# Providers
# native = PDF.js selectable text
# tesseract = local OCR (tesseract.js)
# heuristic = deterministic rule-based extraction (NOT an LLM)
# mock = fixtures only, for tests — never use as a silent production default
DOCUMENT_TEXT_PROVIDER=native
OCR_PROVIDER=tesseract
AI_PROVIDER=heuristic
AI_API_KEY=
AI_MODEL=

# Uploads
MAX_FILE_SIZE=26214400
MAX_PAGES=200

# Auth-only seed (no documents). npm run db:seed
SEED_DEMO_USER=true
SEED_EMAIL=recruiter@folio.dev
SEED_PASSWORD=RecruiterDemo123!
